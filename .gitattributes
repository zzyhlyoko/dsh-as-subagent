# Store every text file with LF line endings.
* text=auto eol=lf

# cmd.exe parses multi-line blocks only when the file uses CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaries: leave bytes unchanged and do not apply the LF rule above.
*.exe  -text -diff !eol
*.dll  -text -diff !eol
*.pdb  -text -diff !eol
*.png  -text -diff !eol
*.jpg  -text -diff !eol
*.jpeg -text -diff !eol
*.gif  -text -diff !eol
*.webp -text -diff !eol
*.ico  -text -diff !eol
*.pdf  -text -diff !eol
*.zip  -text -diff !eol
*.gz   -text -diff !eol
*.7z   -text -diff !eol
